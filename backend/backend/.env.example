# Sambandh Setu API — environment variables
# Copy to .env for local development. Never commit real values.

PORT=5000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Production: a Postgres URL (Neon via the Vercel integration sets DATABASE_URL automatically).
# Local: leave empty to use SQLite at backend/backend/data/sambandh_setu.db
DATABASE_URL=
# Set to false only for providers that use a private certificate authority.
PGSSL_REJECT_UNAUTHORIZED=true

# --- Secrets (at least 32 random characters each) ---------------------------
JWT_SECRET=
OTP_HMAC_SECRET=

# --- Public URL of the web app (used in family invitation links) -----------
APP_URL=http://localhost:8081

# --- Email (optional) -------------------------------------------------------
# Without email, sign-up still works with a password; email codes (sign-in by code, password
# reset, email change) report "not available". Use EMAIL_PROVIDER=console locally to print codes
# in the server log (refused in production).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Sambandh Setu

# --- Setu Guide AI service (optional) ---------------------------------------
# When empty or unreachable, the API answers with its built-in responder.
GUIDE_SERVICE_URL=
GUIDE_SERVICE_KEY=
GUIDE_RATE_PER_MINUTE=20

# --- Team review tools (optional, at least 24 characters) ------------------
ADMIN_API_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Empty = allow all.
# The web app on Vercel calls the API on the same origin, so CORS does not apply there.
CORS_ALLOWED_ORIGINS=

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000

# --- Error monitoring (optional) --------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
