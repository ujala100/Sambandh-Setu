# ========================================================
# Setu Guide AI Microservice Environment Configuration
# ========================================================

# Model & Provider Configuration
# Set USE_MOCK=false to use Google AI Studio Gemini API live
USE_MOCK=false
LLM_PROVIDER=gemini

# Google AI Studio Gemini Model (e.g., gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# API Key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
LLM_API_KEY=your-gemini-api-key-from-google-ai-studio

# Maximum time for Gemini generation budget (seconds)
LLM_TIMEOUT_SECONDS=35

# Rate Limiting
RATE_LIMIT_PER_USER=30/minute
RATE_LIMIT_PER_IP=60/minute
TRUSTED_PROXY=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ITEMS=500

# Logging Level: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
